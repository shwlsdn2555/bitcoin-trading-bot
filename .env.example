# Required for Discord alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me

# Swing portfolio market
BOT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
BOT_TIMEFRAME=4h

# Alert pacing
BOT_POLL_SECONDS=15
BOT_MAX_ALERTS_PER_DAY=2
BOT_MIN_ALERT_GAP_MINUTES=21
BOT_LOSS_COOLDOWN_HOURS=4

# Signal thresholds inherited from the current strategy
BOT_LONG_VOL_MULT=2.618
BOT_SHORT_VOL_MULT=1.618
BOT_LONG_ATR_MULT=1.618
BOT_SHORT_ATR_MULT=1.272
BOT_SLOPE_LOOKBACK_4H=12

# Plan levels
BOT_TP1_LONG=0.01272
BOT_TP2_LONG=0.02000
BOT_TP1_SHORT=0.00890
BOT_TP2_SHORT=0.01218
BOT_SL_LONG=0.00890
BOT_SL_SHORT=0.00890
BOT_SLIPPAGE_BPS=3

# Risk guide shown in alerts
BOT_ACCOUNT_RISK_PCT=0.005
BOT_MAX_RECOMMENDED_LEVERAGE=10
BOT_LIQUIDATION_BUFFER_PCT=0.04

# Advanced filters and scoring
BOT_MIN_SIGNAL_SCORE=68
BOT_MIN_RR_TP2=1.35
BOT_MIN_ADX=18
BOT_MIN_ATR_PERCENTILE=0.35
BOT_MAX_ATR_PERCENTILE=0.95
BOT_MIN_BB_WIDTH_PCT=0.004

# Dynamic ATR-based plan levels
BOT_USE_DYNAMIC_LEVELS=true
BOT_ATR_STOP_MULT=1.25
BOT_ATR_TP1_R=1.20
BOT_ATR_TP2_R=2.00
BOT_MAX_DYNAMIC_STOP_PCT=0.018

# Futures overheating filters
BOT_MAX_ABS_FUNDING_RATE=0.00075
BOT_MAX_OI_CHANGE_PCT=0.08

# Alert result tracking
BOT_TRACK_ALERTS=true
BOT_MAX_TRACK_BARS=288

# Optional scheduled no-trade windows in UTC JSON
# BOT_NO_TRADE_WINDOWS_UTC=[{"start":"2026-05-01T12:00:00Z","end":"2026-05-01T13:00:00Z","reason":"major event"}]

# Local files
BOT_STATE_PATH=./state_alert_only.json
BOT_LOG_DIR=./logs

# Default researched strategy: monthly ~6%, historical MDD ~23% in 2023-04-28 to 2026-04-28 backtest
BOT_DONCHIAN_LOOKBACK=10
BOT_ADX_MIN=20
BOT_STOP_ATR_MULT=2.0
BOT_TARGET_ATR_MULT=4.0
BOT_MAX_HOLD_BARS=24

# Portfolio risk controls
BOT_RISK_PCT=0.03
BOT_MAX_POSITIONS=2
BOT_MAX_SAME_SIDE=1
BOT_MAX_POSITION_FRACTION=1.5
BOT_MAX_TOTAL_EXPOSURE=3.0
BOT_MONTHLY_REDUCE_AT=-0.06
BOT_MONTHLY_STOP_AT=-0.10

# Alert display modes
BOT_STABLE_RISK_PCT=0.015
BOT_AGGRESSIVE_RISK_PCT=0.04
