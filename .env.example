# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me

# KakaoTalk notifications
# Requires Kakao Developers setup. Keep real tokens only in .env.
KAKAO_NOTIFY_ENABLED=false
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Swing portfolio market
BOT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
BOT_TIMEFRAME=4h

# Polling
BOT_POLL_SECONDS=300

# Researched default strategy
# Backtest reference: 2023-04-28 to 2026-04-28, monthly compound about 6.0%, MDD about -23.0%.
BOT_DONCHIAN_LOOKBACK=10
BOT_ADX_MIN=20
BOT_STOP_ATR_MULT=2.0
BOT_TARGET_ATR_MULT=4.0
BOT_MAX_HOLD_BARS=24

# Portfolio risk controls
BOT_RISK_PCT=0.03
BOT_MAX_POSITIONS=2
BOT_MAX_SAME_SIDE=1
BOT_MAX_POSITION_FRACTION=1.5
BOT_MAX_TOTAL_EXPOSURE=3.0
BOT_VOL_FILTER=none

# Monthly drawdown controls
BOT_MONTHLY_REDUCE_AT=-0.06
BOT_MONTHLY_STOP_AT=-0.10

# Stable alternative candidate
# Backtest reference: monthly compound about 4.40%, MDD about -19.85%.
# To run this conservative mode, replace the live risk settings above with:
# BOT_RISK_PCT=0.025
# BOT_MONTHLY_REDUCE_AT=-0.08
# BOT_MONTHLY_STOP_AT=-0.12
# BOT_VOL_FILTER=skip_extreme

# Alert display modes
BOT_STABLE_RISK_PCT=0.015
BOT_AGGRESSIVE_RISK_PCT=0.04

# Local files
BOT_STATE_PATH=./state_swing_portfolio.json
BOT_LOG_DIR=./logs
